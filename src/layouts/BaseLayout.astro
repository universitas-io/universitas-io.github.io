---
import type { Locale } from '../i18n/routes';
import { organization, website } from '../lib/seo/jsonld';
import Seo from '../components/seo/Seo.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileNav from '../components/layout/MobileNav.astro';
import MobileCtaBar from '../components/layout/MobileCtaBar.astro';
import '../styles/global.css';

export interface Props {
  lang: Locale;
  title: string;
  description: string;
  pathname: string;
  alternates: Partial<Record<Locale, string>>;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  lang,
  title,
  description,
  pathname,
  alternates,
  ogImage,
  type = 'website',
  noindex = false,
  jsonLd = [],
  publishedTime,
  modifiedTime
} = Astro.props;

const htmlLang = lang === 'pt' ? 'pt-BR' : 'en';

const defaultSchemas: Record<string, unknown>[] = [
  organization(),
  website(lang),
  ...jsonLd
];
---

<!doctype html>
<html lang={htmlLang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Theme initialization script before CSS to avoid FOUC -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const pref = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
          const theme = stored || pref;
          document.documentElement.setAttribute('data-theme', theme);
        } catch {}
      })();
    </script>
    <Seo
      title={title}
      description={description}
      lang={lang}
      pathname={pathname}
      alternates={alternates}
      ogImage={ogImage}
      type={type}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />

    <JsonLd schema={defaultSchemas} />
  </head>
  <body class="flex flex-col min-h-screen pb-16 md:pb-0">
    <SkipLink lang={lang} />
    <Header lang={lang} alternates={alternates} />

    <main id="main-content" class="flex-1 focus:outline-none" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} />
    <MobileCtaBar lang={lang} />
    <MobileNav lang={lang} alternates={alternates} />

    <script>
      import '../scripts/theme';
      import '../scripts/mobile-nav';
    </script>
  </body>
</html>
