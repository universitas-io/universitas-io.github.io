---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/routes';
import { path } from '../i18n/routes';
import { t } from '../i18n/ui';
import PageLayout from '../layouts/PageLayout.astro';
import InsightList from '../components/sections/InsightList.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';

export interface Props {
  posts: CollectionEntry<'insights'>[];
  lang: Locale;
}

const { posts, lang } = Astro.props;

const currentPath = path(lang, 'insights');
const alternates = {
  pt: path('pt', 'insights'),
  en: path('en', 'insights')
};

const crumbs = [
  { name: t(lang, 'breadcrumb.home'), pathname: path(lang, 'home') },
  { name: t(lang, 'nav.insights'), pathname: currentPath }
];

const heading = t(lang, 'nav.insights');
const lead =
  lang === 'pt'
    ? 'Artigos, reflexões metodológicas e guias práticos sobre pesquisa empírica, análise de dados e ética científica.'
    : 'Articles, methodological essays, and practical guides on empirical research, data analytics, and scientific ethics.';
const eyebrow =
  lang === 'pt' ? 'Conhecimento & Métodos' : 'Knowledge & Methods';
---

<PageLayout
  lang={lang}
  title={heading}
  description={lead}
  pathname={currentPath}
  alternates={alternates}
  heading={heading}
  lead={lead}
  eyebrow={eyebrow}
  crumbs={crumbs}
>
  <div class="space-y-16">
    {posts.length === 0 ? (
      <div class="p-12 rounded-2xl bg-surface-alt dark:bg-navy-900 border border-gray-200/80 dark:border-navy-700/60 text-center max-w-2xl mx-auto space-y-3">
        <p class="text-lg font-medium text-navy-900 dark:text-white">
          {lang === 'pt'
            ? 'Nenhum artigo publicado no momento.'
            : 'No articles published at the moment.'}
        </p>
        <p class="text-ink-600 dark:text-gray-400 text-sm">
          {lang === 'pt'
            ? 'Em breve compartilharemos novas análises, guias de pesquisa e discussões metodológicas.'
            : 'We will soon publish new methodological analyses, research guides, and technical discussions.'}
        </p>
      </div>
    ) : (
      <InsightList posts={posts} lang={lang} />
    )}

    <CtaBanner lang={lang} />
  </div>
</PageLayout>
