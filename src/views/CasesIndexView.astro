---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/routes';
import { path } from '../i18n/routes';
import { t } from '../i18n/ui';
import PageLayout from '../layouts/PageLayout.astro';
import CaseGrid from '../components/sections/CaseGrid.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';

export interface Props {
  cases: CollectionEntry<'cases'>[];
  lang: Locale;
}

const { cases, lang } = Astro.props;

const currentPath = path(lang, 'cases');
const alternates = {
  pt: path('pt', 'cases'),
  en: path('en', 'cases')
};

const crumbs = [
  { name: t(lang, 'breadcrumb.home'), pathname: path(lang, 'home') },
  { name: t(lang, 'nav.cases'), pathname: currentPath }
];

const heading = t(lang, 'nav.cases');
const lead =
  lang === 'pt'
    ? 'Conheça projetos de pesquisa empírica, estruturação de dados e desenvolvimento que realizamos para universidades, empresas e o setor público.'
    : 'Explore empirical research, data engineering, and software projects delivered for universities, businesses, and the public sector.';
const eyebrow =
  lang === 'pt' ? 'Portfólio & Evidências' : 'Portfolio & Evidence';
---

<PageLayout
  lang={lang}
  title={heading}
  description={lead}
  pathname={currentPath}
  alternates={alternates}
  heading={heading}
  lead={lead}
  eyebrow={eyebrow}
  crumbs={crumbs}
>
  <div class="space-y-16">
    <CaseGrid cases={cases} lang={lang} />
    <CtaBanner lang={lang} />
  </div>
</PageLayout>
