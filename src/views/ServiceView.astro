---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import type { Locale } from '../i18n/routes';
import { path } from '../i18n/routes';
import { t } from '../i18n/ui';
import { entrySlug, getLocalized } from '../lib/content';
import {
  service as makeServiceSchema,
  faqPage as makeFaqSchema
} from '../lib/seo/jsonld';
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import ToolList from '../components/sections/ToolList.astro';
import Faq from '../components/sections/Faq.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';
import Card from '../components/ui/Card.astro';

export interface Props {
  service: CollectionEntry<'services'>;
  lang: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { service, lang, alternates } = Astro.props;

const { Content } = await render(service);

const slug = entrySlug(service.id);
const currentPath = `${path(lang, 'services')}${slug}/`;

const crumbs = [
  { name: t(lang, 'nav.services'), pathname: path(lang, 'services') },
  { name: service.data.title, pathname: currentPath }
];

const jsonLd: Record<string, unknown>[] = [
  makeServiceSchema({
    name: service.data.title,
    description: service.data.description,
    pathname: currentPath,
    lang,
    audience: service.data.audiences
  })
];

if (service.data.faq && service.data.faq.length > 0) {
  jsonLd.push(makeFaqSchema(service.data.faq));
}

const allCases = await getLocalized('cases', lang);
const matchedCases = allCases
  .filter((c) => c.data.services.includes(service.data.translationKey))
  .sort((a, b) => a.data.order - b.data.order);

const renderedCases = await Promise.all(
  matchedCases.map(async (caseItem) => {
    const { Content: CaseContent } = await render(caseItem);
    return { caseItem, CaseContent };
  })
);
---

<PageLayout
  lang={lang}
  title={service.data.title}
  description={service.data.description}
  pathname={currentPath}
  alternates={alternates}
  heading={service.data.title}
  lead={service.data.summary}
  eyebrow={
    service.data.tier === 'core'
      ? lang === 'pt'
        ? 'Serviço Principal'
        : 'Core Service'
      : lang === 'pt'
        ? 'Serviço Complementar'
        : 'Complementary Service'
  }
  crumbs={crumbs}
  jsonLd={jsonLd}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    <!-- Main Content Column -->
    <div class="lg:col-span-8 space-y-12">
      <!-- Markdown Body -->
      <article class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-display prose-headings:tracking-tight prose-h2:text-2xl prose-h2:sm:text-3xl prose-h2:font-bold prose-h2:text-navy-900 dark:prose-h2:text-white prose-p:text-ink-600 dark:prose-p:text-gray-300 prose-p:leading-relaxed prose-li:text-ink-600 dark:prose-li:text-gray-300">
        <Content />
      </article>

      <!-- Deliverables Section -->
      {service.data.deliverables && service.data.deliverables.length > 0 && (
        <section class="space-y-4 pt-6 border-t border-gray-200 dark:border-navy-700/60">
          <h2 class="text-2xl font-bold font-display text-navy-900 dark:text-white">
            {lang === 'pt' ? 'O que você recebe' : 'What We Deliver'}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {service.data.deliverables.map((item) => (
              <div class="flex items-start gap-3 p-4 rounded-xl bg-surface-alt dark:bg-navy-700/30 border border-gray-200/80 dark:border-navy-700/60">
                <div class="shrink-0 w-6 h-6 rounded-full bg-blue-500/10 text-blue-500 flex items-center justify-center mt-0.5">
                  <svg
                    class="w-4 h-4"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </div>
                <span class="text-sm font-medium text-navy-900 dark:text-gray-200 leading-snug">
                  {item}
                </span>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- FAQ Section -->
      {service.data.faq && service.data.faq.length > 0 && (
        <div class="pt-6 border-t border-gray-200 dark:border-navy-700/60">
          <Faq items={service.data.faq} lang={lang} />
        </div>
      )}

      <!-- Applied Cases / Examples Section (directly below FAQ) -->
      {renderedCases.length > 0 && (
        <section
          class="space-y-8 pt-8 border-t border-gray-200 dark:border-navy-700/60"
          aria-labelledby="cases-showcase-heading"
        >
          <div class="space-y-2">
            <span class="text-xs font-bold uppercase tracking-wider text-[#1a6ca8] dark:text-blue-400">
              {lang === 'pt' ? 'Casos Reais & Portfólio' : 'Portfolio & Case Studies'}
            </span>
            <h2
              id="cases-showcase-heading"
              class="text-2xl sm:text-3xl font-bold font-display text-navy-900 dark:text-white"
            >
              {lang === 'pt'
                ? 'Exemplos de Projetos Realizados'
                : 'Real-World Projects & Examples'}
            </h2>
            <p class="text-ink-600 dark:text-gray-300 text-sm max-w-2xl leading-relaxed">
              {lang === 'pt'
                ? 'Aplicações práticas e soluções desenvolvidas neste serviço, com objetivos, abordagem metodológica e entregáveis.'
                : 'Practical applications and solutions developed for this service, detailing objectives, methodology, and deliverables.'}
            </p>
          </div>

          <div class="space-y-12">
            {renderedCases.map(({ caseItem, CaseContent }) => (
              <article class="p-6 sm:p-8 rounded-2xl bg-surface-alt/70 dark:bg-navy-900/60 border border-gray-200/80 dark:border-navy-700/60 space-y-6">
                <!-- Case Header: Meta & Title -->
                <div class="space-y-3">
                  <div class="flex flex-wrap items-center gap-2">
                    {caseItem.data.client && (
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-[#1a6ca8] dark:bg-blue-900/40 dark:text-blue-300">
                        {caseItem.data.client}
                      </span>
                    )}
                    {caseItem.data.sector && (
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-200/70 text-gray-700 dark:bg-navy-800 dark:text-gray-300 capitalize">
                        {caseItem.data.sector === 'academia'
                          ? (lang === 'pt' ? 'Academia' : 'Academia')
                          : caseItem.data.sector === 'business'
                            ? (lang === 'pt' ? 'Empresas' : 'Business')
                            : caseItem.data.sector === 'public'
                              ? (lang === 'pt' ? 'Setor Público' : 'Public Sector')
                              : (lang === 'pt' ? 'ONGs' : 'NGOs')}
                      </span>
                    )}
                    {caseItem.data.date && (
                      <span class="text-xs text-ink-600 dark:text-gray-400">
                        {new Intl.DateTimeFormat(
                          lang === 'pt' ? 'pt-BR' : 'en-US',
                          { month: 'long', year: 'numeric' }
                        ).format(caseItem.data.date)}
                      </span>
                    )}
                  </div>

                  <h3 class="text-xl sm:text-2xl font-bold font-display text-navy-900 dark:text-white leading-tight">
                    {caseItem.data.title}
                  </h3>

                  {caseItem.data.description && (
                    <p class="text-ink-600 dark:text-gray-300 text-sm leading-relaxed italic">
                      {caseItem.data.description}
                    </p>
                  )}
                </div>

                <!-- Cover Image -->
                {caseItem.data.cover && (
                  <figure class="rounded-xl overflow-hidden border border-gray-200 dark:border-navy-700/60 bg-white dark:bg-navy-950 shadow-sm">
                    <Image
                      src={caseItem.data.cover.src}
                      alt={caseItem.data.cover.alt}
                      class="w-full h-auto object-cover max-h-[480px]"
                      width={1000}
                      height={560}
                      loading="lazy"
                    />
                    {caseItem.data.cover.alt && (
                      <figcaption class="text-xs text-ink-600 dark:text-gray-400 p-2 text-center bg-gray-50 dark:bg-navy-900/80 border-t border-gray-200 dark:border-navy-700/60">
                        {caseItem.data.cover.alt}
                      </figcaption>
                    )}
                  </figure>
                )}

                <!-- Case Markdown Body -->
                <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-display prose-headings:tracking-tight prose-h2:text-xl prose-h2:font-bold prose-h2:text-navy-900 dark:prose-h2:text-white prose-p:text-ink-600 dark:prose-p:text-gray-300 prose-p:leading-relaxed prose-li:text-ink-600 dark:prose-li:text-gray-300 prose-strong:text-navy-900 dark:prose-strong:text-white">
                  <CaseContent />
                </div>

                <!-- Gallery -->
                {caseItem.data.gallery && caseItem.data.gallery.length > 0 && (
                  <div class="space-y-3 pt-4 border-t border-gray-200 dark:border-navy-700/60">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-ink-600 dark:text-gray-400">
                      {lang === 'pt' ? 'Imagens do Projeto' : 'Project Images'}
                    </h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                      {caseItem.data.gallery.map((img) => (
                        <figure class="rounded-xl overflow-hidden border border-gray-200 dark:border-navy-700/60 bg-white dark:bg-navy-950 p-1.5 space-y-1.5">
                          <Image
                            src={img.src}
                            alt={img.alt}
                            class="w-full h-auto rounded-lg object-cover"
                            width={600}
                            height={375}
                            loading="lazy"
                          />
                          <figcaption class="text-xs text-ink-600 dark:text-gray-400 px-1 pb-1 text-center">
                            {img.alt}
                          </figcaption>
                        </figure>
                      ))}
                    </div>
                  </div>
                )}

                <!-- Technologies & Links -->
                {((caseItem.data.tools && caseItem.data.tools.length > 0) ||
                  (caseItem.data.links && caseItem.data.links.length > 0)) && (
                  <div class="pt-4 border-t border-gray-200 dark:border-navy-700/60 flex flex-wrap items-center justify-between gap-4">
                    {caseItem.data.tools && caseItem.data.tools.length > 0 && (
                      <div class="space-y-1.5">
                        <span class="text-xs font-bold uppercase tracking-wider text-ink-600 dark:text-gray-400 block">
                          {lang === 'pt' ? 'Tecnologias' : 'Technologies'}
                        </span>
                        <div class="flex flex-wrap gap-1.5">
                          {caseItem.data.tools.map((tool) => (
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-white dark:bg-navy-800 text-ink-700 dark:text-gray-300 border border-gray-200 dark:border-navy-700">
                              {tool}
                            </span>
                          ))}
                        </div>
                      </div>
                    )}

                    {caseItem.data.links && caseItem.data.links.length > 0 && (
                      <div class="space-y-1.5">
                        <span class="text-xs font-bold uppercase tracking-wider text-ink-600 dark:text-gray-400 block">
                          {lang === 'pt' ? 'Links' : 'Links'}
                        </span>
                        <div class="flex flex-wrap gap-2">
                          {caseItem.data.links.map((link) => (
                            <a
                              href={link.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#1a6ca8] hover:text-blue-700 dark:text-blue-400 hover:underline"
                            >
                              <span>{link.label}</span>
                              <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h4a.75.75 0 0 1 0 1.5h-4Z" clip-rule="evenodd" />
                                <path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06 1.06L13 8.12v2.63a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.63l-5.686 5.693Z" clip-rule="evenodd" />
                              </svg>
                            </a>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- Sidebar Column -->
    <aside class="lg:col-span-4 space-y-6">
      <Card class="space-y-6 sticky top-24">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-ink-600 dark:text-gray-400">
            {lang === 'pt'
              ? 'Ferramentas & Tecnologias'
              : 'Tools & Technologies'}
          </span>
          <div class="mt-3">
            <ToolList tools={service.data.tools} />
          </div>
        </div>

        <div class="pt-4 border-t border-gray-200 dark:border-navy-700/60 space-y-3">
          <h3 class="text-base font-bold text-navy-900 dark:text-white">
            {lang === 'pt' ? 'Precisa deste serviço?' : 'Need this service?'}
          </h3>
          <p class="text-xs text-ink-600 dark:text-gray-400 leading-relaxed">
            {lang === 'pt'
              ? 'Desenhamos cada projeto sob medida com transparência metodológica e orçamento sem compromisso.'
              : 'Every project is tailored with methodological transparency and upfront scoping.'}
          </p>
          <a
            href={path(lang, 'contact')}
            class="block w-full text-center py-2.5 px-4 rounded-lg bg-[#1a6ca8] hover:bg-[#155a8a] text-white font-semibold text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            {t(lang, 'cta.proposal')}
          </a>
        </div>
      </Card>
    </aside>
  </div>

  <div class="mt-20">
    <CtaBanner lang={lang} />
  </div>
</PageLayout>
