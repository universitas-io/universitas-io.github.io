---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/routes';
import { path } from '../i18n/routes';
import { t } from '../i18n/ui';
import { entrySlug, byTranslationKeys } from '../lib/content';
import { article as makeArticleSchema } from '../lib/seo/jsonld';
import { site } from '../../site.config';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import ToolList from '../components/sections/ToolList.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';

export interface Props {
  caseItem: CollectionEntry<'cases'>;
  lang: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { caseItem, lang, alternates } = Astro.props;

const { Content } = await render(caseItem);

const slug = entrySlug(caseItem.id);
const currentPath = `${path(lang, 'cases')}${slug}/`;

const crumbs = [
  { name: t(lang, 'breadcrumb.home'), pathname: path(lang, 'home') },
  { name: t(lang, 'nav.cases'), pathname: path(lang, 'cases') },
  { name: caseItem.data.title, pathname: currentPath }
];

const sectorLabels: Record<string, Record<Locale, string>> = {
  academia: { pt: 'Academia', en: 'Academia' },
  business: { pt: 'Empresas', en: 'Business' },
  public: { pt: 'Setor Público', en: 'Public Sector' }
};

const meta: { label: string; value: string }[] = [
  {
    label: lang === 'pt' ? 'Setor' : 'Sector',
    value: sectorLabels[caseItem.data.sector]?.[lang] ?? caseItem.data.sector
  }
];

if (caseItem.data.client) {
  meta.push({
    label: lang === 'pt' ? 'Cliente' : 'Client',
    value: caseItem.data.client
  });
}

if (caseItem.data.date) {
  const formattedDate = new Intl.DateTimeFormat(
    lang === 'pt' ? 'pt-BR' : 'en-US',
    { month: 'long', year: 'numeric' }
  ).format(caseItem.data.date);
  meta.push({
    label: lang === 'pt' ? 'Data' : 'Date',
    value: formattedDate
  });
}

const jsonLd: Record<string, unknown>[] = [
  makeArticleSchema({
    headline: caseItem.data.title,
    description: caseItem.data.description,
    pathname: currentPath,
    lang,
    datePublished: caseItem.data.date
      ? caseItem.data.date.toISOString()
      : '2025-01-01T00:00:00Z',
    author: {
      name: 'Universitas',
      url: site.url
    }
  })
];

const relatedServices = await byTranslationKeys(
  'services',
  caseItem.data.services,
  lang
);
---

<ArticleLayout
  lang={lang}
  title={caseItem.data.title}
  description={caseItem.data.description}
  pathname={currentPath}
  alternates={alternates}
  heading={caseItem.data.title}
  lead={caseItem.data.description}
  eyebrow={lang === 'pt' ? 'Estudo de Caso' : 'Case Study'}
  crumbs={crumbs}
  jsonLd={jsonLd}
  cover={caseItem.data.cover}
  meta={meta}
>
  <div class="space-y-12">
    <!-- Main Article Body -->
    <article class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-display prose-headings:tracking-tight prose-h2:text-2xl prose-h2:sm:text-3xl prose-h2:font-bold prose-h2:text-navy-900 dark:prose-h2:text-white prose-p:text-ink-600 dark:prose-p:text-gray-300 prose-p:leading-relaxed prose-li:text-ink-600 dark:prose-li:text-gray-300 prose-a:text-[#1a6ca8] dark:prose-a:text-blue-400">
      <Content />
    </article>

    <!-- Gallery (if available) -->
    {caseItem.data.gallery && caseItem.data.gallery.length > 0 && (
      <section
        class="space-y-4 pt-6 border-t border-gray-200 dark:border-navy-700/60"
        aria-labelledby="gallery-heading"
      >
        <h2
          id="gallery-heading"
          class="text-2xl font-bold font-display text-navy-900 dark:text-white"
        >
          {lang === 'pt' ? 'Galeria do Projeto' : 'Project Gallery'}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {caseItem.data.gallery.map((img) => (
            <figure class="rounded-xl overflow-hidden border border-gray-200 dark:border-navy-700/60 bg-surface-alt dark:bg-navy-900 space-y-2 p-2">
              <Image
                src={img.src}
                alt={img.alt}
                class="w-full h-auto rounded-lg object-cover"
                width={800}
                height={500}
              />
              <figcaption class="text-xs text-ink-600 dark:text-gray-400 px-2 pb-1 text-center">
                {img.alt}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Tools & Technologies -->
    {caseItem.data.tools && caseItem.data.tools.length > 0 && (
      <section
        class="space-y-3 pt-6 border-t border-gray-200 dark:border-navy-700/60"
        aria-labelledby="tools-heading"
      >
        <h3
          id="tools-heading"
          class="text-sm font-bold uppercase tracking-wider text-ink-600 dark:text-gray-400"
        >
          {lang === 'pt' ? 'Ferramentas Utilizadas' : 'Tools & Technologies'}
        </h3>
        <ToolList tools={caseItem.data.tools} />
      </section>
    )}

    <!-- External Links -->
    {caseItem.data.links && caseItem.data.links.length > 0 && (
      <section
        class="p-6 rounded-xl bg-surface-alt dark:bg-navy-900/60 border border-gray-200 dark:border-navy-700/60 space-y-3"
        aria-labelledby="links-heading"
      >
        <h3
          id="links-heading"
          class="text-sm font-bold uppercase tracking-wider text-navy-900 dark:text-white"
        >
          {lang === 'pt'
            ? 'Links e Recursos Externos'
            : 'External Links & Resources'}
        </h3>
        <ul class="space-y-2">
          {caseItem.data.links.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-semibold text-[#1a6ca8] hover:text-blue-700 dark:text-blue-400 hover:underline"
              >
                <span>{link.label}</span>
                <svg
                  class="w-4 h-4"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h4a.75.75 0 0 1 0 1.5h-4Z"
                    clip-rule="evenodd"
                  />
                  <path
                    fill-rule="evenodd"
                    d="M6.194 12.753a.75.75 0 0 0 1.06 1.06L13 8.12v2.63a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.63l-5.686 5.693Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Services Applied -->
    {relatedServices.length > 0 && (
      <section
        class="space-y-4 pt-6 border-t border-gray-200 dark:border-navy-700/60"
        aria-labelledby="services-heading"
      >
        <h3
          id="services-heading"
          class="text-sm font-bold uppercase tracking-wider text-ink-600 dark:text-gray-400"
        >
          {lang === 'pt' ? 'Serviços Relacionados' : 'Related Services'}
        </h3>
        <div class="flex flex-wrap gap-2">
          {relatedServices.map((service) => (
            <a
              href={`${path(lang, 'services')}${entrySlug(service.id)}/`}
              class="inline-flex items-center px-3 py-1.5 rounded-lg text-sm font-medium bg-blue-50 dark:bg-navy-900 text-[#1a6ca8] dark:text-blue-400 border border-blue-200 dark:border-navy-700/60 hover:bg-blue-100 transition-colors"
            >
              {service.data.title}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- CTA Banner -->
    <div class="pt-8">
      <CtaBanner lang={lang} />
    </div>
  </div>
</ArticleLayout>
