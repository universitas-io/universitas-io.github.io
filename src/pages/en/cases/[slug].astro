---
import type { CollectionEntry } from 'astro:content';
import { getLocalized, translationOf, entrySlug } from '../../../lib/content';
import { path } from '../../../i18n/routes';
import CaseView from '../../../views/CaseView.astro';

export async function getStaticPaths() {
  const cases = await getLocalized('cases', 'en');

  const paths = await Promise.all(
    cases.map(async (caseItem) => {
      const slug = entrySlug(caseItem.id);
      const ptPair = await translationOf(caseItem, 'pt');

      const alternates: { en: string; pt?: string } = {
        en: `${path('en', 'cases')}${slug}/`
      };
      if (ptPair) {
        alternates.pt = `${path('pt', 'cases')}${entrySlug(ptPair.id)}/`;
      }

      return {
        params: { slug },
        props: { caseItem, alternates }
      };
    })
  );

  return paths;
}

export interface Props {
  caseItem: CollectionEntry<'cases'>;
  alternates: { en: string; pt?: string };
}

const { caseItem, alternates } = Astro.props;
---

<CaseView caseItem={caseItem} lang="en" alternates={alternates} />
