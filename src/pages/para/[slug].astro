---
import type { CollectionEntry } from 'astro:content';
import {
  getLocalized,
  translationOf,
  entrySlug,
  byTranslationKeys
} from '../../lib/content';
import { path } from '../../i18n/routes';
import AudienceView from '../../views/AudienceView.astro';

export async function getStaticPaths() {
  const audiences = await getLocalized('audiences', 'pt');

  const paths = await Promise.all(
    audiences.map(async (audience) => {
      const slug = entrySlug(audience.id);
      const enPair = await translationOf(audience, 'en');

      const alternates: { pt: string; en?: string } = {
        pt: path('pt', 'audiences', slug)
      };
      if (enPair) {
        alternates.en = path('en', 'audiences', entrySlug(enPair.id));
      }

      const relatedServices = await byTranslationKeys(
        'services',
        audience.data.services,
        'pt'
      );

      return {
        params: { slug },
        props: { audience, alternates, relatedServices }
      };
    })
  );

  return paths;
}

export interface Props {
  audience: CollectionEntry<'audiences'>;
  alternates: { pt: string; en?: string };
  relatedServices: CollectionEntry<'services'>[];
}

const { audience, alternates, relatedServices } = Astro.props;
---

<AudienceView
  audience={audience}
  lang="pt"
  alternates={alternates}
  relatedServices={relatedServices}
/>
