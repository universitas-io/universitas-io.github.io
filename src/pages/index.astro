---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import NetworkPattern from '../components/ui/NetworkPattern.astro';
import { path } from '../i18n/routes';

const title =
  'Universitas — Consultoria em pesquisa quantitativa e qualitativa';
const description =
  'Pesquisa quantitativa e qualitativa para universidades, empresas e setor público, com método, ética e transparência.';
---

<BaseLayout
  lang="pt"
  title={title}
  description={description}
  pathname="/"
  alternates={{ pt: '/', en: '/en/' }}
>
  <section class="relative overflow-hidden py-16 sm:py-24 lg:py-32 bg-gradient-to-b from-surface-alt/60 to-white dark:from-[#0B1626] dark:to-[#0F2340]">
    <NetworkPattern class="absolute inset-0 w-full h-full text-blue-500/10 dark:text-blue-400/10" />
    <Container class="relative z-10">
      <div class="max-w-3xl">
        <SectionHeading
          align="left"
          eyebrow="Consultoria em pesquisa"
          title="Evidências rigorosas para decisões e descobertas."
          lead="Pesquisa quantitativa e qualitativa para universidades, empresas e setor público, com método, ética e transparência."
          level={1}
        />
        <div class="flex flex-wrap items-center gap-4 mt-8">
          <Button href={path('pt', 'contact')} variant="primary" size="lg">
            Solicitar proposta
          </Button>
          <Button href={path('pt', 'services')} variant="outline" size="lg">
            Ver serviços
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
