---
import type { Locale } from '../../i18n/routes';
import { path } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { site } from '../../../site.config';
import Button from '../ui/Button.astro';

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const whatsappUrl = `https://wa.me/${site.contact.whatsapp}`;
const contactUrl = path(lang, 'contact');
---

<aside
  class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 dark:bg-[#0F2340]/95 backdrop-blur-md border-t border-gray-200 dark:border-navy-700/60 px-4 py-2.5 shadow-lg"
  aria-label="Ações rápidas"
>
  <div class="flex items-center gap-2 max-w-lg mx-auto">
    <Button
      href={contactUrl}
      variant="primary"
      size="sm"
      class="flex-1 font-semibold py-2.5"
    >
      {t(lang, 'cta.proposal')}
    </Button>
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t(lang, 'cta.whatsapp')}
      class="inline-flex items-center justify-center p-2.5 rounded-lg bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-[#25D366] focus:ring-offset-2"
    >
      <svg
        class="w-5 h-5 fill-current"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.65 3.742-.983z"></path>
      </svg>
    </a>
  </div>
</aside>
