---
import type { Locale } from '../../i18n/routes';
import { t } from '../../i18n/ui';

export interface Props {
  lang: Locale;
  targetId?: string;
}

const { lang, targetId = 'main-content' } = Astro.props;
---

<a
  href={`#${targetId}`}
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-navy-900 focus:text-white focus:rounded-md focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
>
  {t(lang, 'skip')}
</a>
