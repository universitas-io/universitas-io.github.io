---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/routes';
import { path } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { entrySlug } from '../../lib/content';
import Icon from '../ui/Icon.astro';
import ToolList from './ToolList.astro';

export interface Props {
  services: CollectionEntry<'services'>[];
  lang: Locale;
  variant?: 'full' | 'compact';
  tier?:
    | 'research-data'
    | 'visualization-dissemination'
    | 'editorial-review'
    | 'core'
    | 'complementary'
    | 'all';
}

const { services, lang, tier = 'all' } = Astro.props;

const researchServices = services
  .filter(
    (s) =>
      s.data.tier === 'research-data' ||
      (s.data.tier === 'core' &&
        ['quantitative', 'qualitative', 'digital-data'].includes(
          s.data.translationKey
        ))
  )
  .sort((a, b) => a.data.order - b.data.order);

const vizServices = services
  .filter(
    (s) =>
      s.data.tier === 'visualization-dissemination' ||
      (s.data.tier === 'complementary' &&
        ['dashboards', 'academic-websites'].includes(s.data.translationKey))
  )
  .sort((a, b) => a.data.order - b.data.order);

const editorialServices = services
  .filter(
    (s) =>
      s.data.tier === 'editorial-review' ||
      (s.data.tier === 'complementary' &&
        ['document-formatting', 'text-editing'].includes(s.data.translationKey))
  )
  .sort((a, b) => a.data.order - b.data.order);

const basePath = path(lang, 'services');
---

<!-- 1. Pesquisa e Coleta de Dados (Azul) -->
{(tier === 'all' || tier === 'research-data' || tier === 'core') &&
  researchServices.length > 0 && (
    <div class="space-y-6" data-tier="research-data">
      {tier === 'all' && (
        <div class="space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-[#1a6ca8] dark:text-blue-400">
            {lang === 'pt'
              ? '1. Pesquisa e coleta'
              : '1. Research and collection'}
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold font-display text-navy-900 dark:text-white">
            {lang === 'pt'
              ? 'Pesquisa e Coleta de Dados'
              : 'Research and Data Collection'}
          </h2>
        </div>
      )}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {researchServices.map((service) => {
          const serviceUrl = `${basePath}${entrySlug(service.id)}/`;
          return (
            <article class="bg-white dark:bg-[#112239] rounded-xl border border-gray-200 dark:border-navy-700/60 p-6 flex flex-col justify-between hover:shadow-lg hover:border-blue-500/50 dark:hover:border-blue-500/40 transition-all duration-200 group">
              <div>
                <div class="w-12 h-12 rounded-lg bg-blue-50 dark:bg-navy-900/60 flex items-center justify-center text-[#1a6ca8] dark:text-blue-400 mb-5 group-hover:scale-105 transition-transform">
                  <Icon name={service.data.icon} size={24} />
                </div>
                <h3 class="text-xl font-bold font-display text-navy-900 dark:text-white mb-2 group-hover:text-[#1a6ca8] dark:group-hover:text-blue-400 transition-colors">
                  <a
                    href={serviceUrl}
                    class="focus:outline-none focus:underline"
                  >
                    {service.data.title}
                  </a>
                </h3>
                <p class="text-ink-600 dark:text-gray-300 text-sm leading-relaxed mb-6">
                  {service.data.summary}
                </p>
              </div>

              <div class="pt-4 border-t border-gray-100 dark:border-navy-700/40 space-y-4">
                {service.data.tools && service.data.tools.length > 0 && (
                  <ToolList tools={service.data.tools.slice(0, 4)} />
                )}
                <a
                  href={serviceUrl}
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#1a6ca8] hover:text-blue-700 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform"
                >
                  <span>{t(lang, 'cta.more')}</span>
                  <svg
                    class="w-4 h-4"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  )}

<!-- 2. Visualização e Disseminação (Verde) -->
{(tier === 'all' ||
  tier === 'visualization-dissemination' ||
  tier === 'complementary') &&
  vizServices.length > 0 && (
    <div class="space-y-6 pt-10" data-tier="visualization-dissemination">
      {tier === 'all' && (
        <div class="space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-[#1e7e4e] dark:text-emerald-400">
            {lang === 'pt'
              ? '2. Visualização e plataformas'
              : '2. Visualization and platforms'}
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold font-display text-navy-900 dark:text-white">
            {lang === 'pt'
              ? 'Visualização e Disseminação'
              : 'Visualization and Dissemination'}
          </h2>
        </div>
      )}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {vizServices.map((service) => {
          const serviceUrl = `${basePath}${entrySlug(service.id)}/`;
          return (
            <article class="bg-white dark:bg-[#112239] rounded-xl border border-gray-200 dark:border-navy-700/60 p-6 flex flex-col justify-between hover:shadow-lg hover:border-emerald-500/50 dark:hover:border-emerald-400/40 transition-all duration-200 group">
              <div>
                <div class="w-12 h-12 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 flex items-center justify-center text-[#1e7e4e] dark:text-emerald-400 mb-5 group-hover:scale-105 transition-transform">
                  <Icon name={service.data.icon} size={24} />
                </div>
                <h3 class="text-xl font-bold font-display text-navy-900 dark:text-white mb-2 group-hover:text-[#1e7e4e] dark:group-hover:text-emerald-400 transition-colors">
                  <a
                    href={serviceUrl}
                    class="focus:outline-none focus:underline"
                  >
                    {service.data.title}
                  </a>
                </h3>
                <p class="text-ink-600 dark:text-gray-300 text-sm leading-relaxed mb-6">
                  {service.data.summary}
                </p>
              </div>

              <div class="pt-4 border-t border-gray-100 dark:border-navy-700/40 space-y-4">
                {service.data.tools && service.data.tools.length > 0 && (
                  <ToolList tools={service.data.tools.slice(0, 4)} />
                )}
                <a
                  href={serviceUrl}
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#1e7e4e] hover:text-emerald-800 dark:text-emerald-400 group-hover:translate-x-0.5 transition-transform"
                >
                  <span>{t(lang, 'cta.more')}</span>
                  <svg
                    class="w-4 h-4"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  )}

<!-- 3. Revisão e Editorial (Âmbar / Amarelo suave dourado) -->
{(tier === 'all' || tier === 'editorial-review' || tier === 'complementary') &&
  editorialServices.length > 0 && (
    <div class="space-y-6 pt-10" data-tier="editorial-review">
      {tier === 'all' && (
        <div class="space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-[#b45309] dark:text-amber-400">
            {lang === 'pt'
              ? '3. Editorial e linguagem'
              : '3. Editorial and language'}
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold font-display text-navy-900 dark:text-white">
            {lang === 'pt' ? 'Revisão e Editorial' : 'Editing and Publishing'}
          </h2>
        </div>
      )}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {editorialServices.map((service) => {
          const serviceUrl = `${basePath}${entrySlug(service.id)}/`;
          return (
            <article class="bg-white dark:bg-[#112239] rounded-xl border border-gray-200 dark:border-navy-700/60 p-6 flex flex-col justify-between hover:shadow-lg hover:border-amber-500/50 dark:hover:border-amber-400/40 transition-all duration-200 group">
              <div>
                <div class="w-12 h-12 rounded-lg bg-amber-50 dark:bg-amber-950/40 flex items-center justify-center text-[#b45309] dark:text-amber-400 mb-5 group-hover:scale-105 transition-transform">
                  <Icon name={service.data.icon} size={24} />
                </div>
                <h3 class="text-xl font-bold font-display text-navy-900 dark:text-white mb-2 group-hover:text-[#b45309] dark:group-hover:text-amber-400 transition-colors">
                  <a
                    href={serviceUrl}
                    class="focus:outline-none focus:underline"
                  >
                    {service.data.title}
                  </a>
                </h3>
                <p class="text-ink-600 dark:text-gray-300 text-sm leading-relaxed mb-6">
                  {service.data.summary}
                </p>
              </div>

              <div class="pt-4 border-t border-gray-100 dark:border-navy-700/40 space-y-4">
                {service.data.tools && service.data.tools.length > 0 && (
                  <ToolList tools={service.data.tools.slice(0, 4)} />
                )}
                <a
                  href={serviceUrl}
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#b45309] hover:text-amber-800 dark:text-amber-400 group-hover:translate-x-0.5 transition-transform"
                >
                  <span>{t(lang, 'cta.more')}</span>
                  <svg
                    class="w-4 h-4"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  )}
