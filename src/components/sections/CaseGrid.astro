---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { Locale } from '../../i18n/routes';
import { path } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { entrySlug } from '../../lib/content';

export interface Props {
  cases: CollectionEntry<'cases'>[];
  lang: Locale;
  limit?: number;
}

const { cases, lang, limit } = Astro.props;

const displayedCases =
  typeof limit === 'number' ? cases.slice(0, limit) : cases;

const sectorLabels: Record<string, Record<Locale, string>> = {
  academia: { pt: 'Academia', en: 'Academia' },
  business: { pt: 'Empresas', en: 'Business' },
  public: { pt: 'Setor Público', en: 'Public Sector' },
  ngo: { pt: 'ONGs & 3º Setor', en: 'NGOs & Non-Profits' }
};
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
  {displayedCases.map((c) => {
    const slug = entrySlug(c.id);
    const caseUrl = `${path(lang, 'cases')}${slug}/`;
    const sectorLabel = sectorLabels[c.data.sector]?.[lang] ?? c.data.sector;

    return (
      <article class="bg-white dark:bg-[#112239] rounded-2xl border border-gray-200 dark:border-navy-700/60 overflow-hidden flex flex-col justify-between hover:shadow-xl hover:border-blue-500/50 dark:hover:border-blue-500/40 transition-all duration-200 group">
        <div>
          {c.data.cover && (
            <div class="aspect-video w-full overflow-hidden bg-surface-alt dark:bg-navy-900 border-b border-gray-100 dark:border-navy-700/40">
              <a
                href={caseUrl}
                tabindex="-1"
                aria-hidden="true"
                class="block h-full"
              >
                <Image
                  src={c.data.cover.src}
                  alt={c.data.cover.alt}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  width={600}
                  height={338}
                />
              </a>
            </div>
          )}

          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-navy-900 text-[#1a6ca8] dark:text-blue-400 border border-blue-200 dark:border-navy-700/60">
                {sectorLabel}
              </span>
              {c.data.client && (
                <span class="text-xs text-ink-600 dark:text-gray-400 truncate">
                  {c.data.client}
                </span>
              )}
            </div>

            <h3 class="text-xl font-bold font-display text-navy-900 dark:text-white mb-2 group-hover:text-[#1a6ca8] dark:group-hover:text-blue-400 transition-colors line-clamp-2">
              <a href={caseUrl} class="focus:outline-none focus:underline">
                {c.data.title}
              </a>
            </h3>

            <p class="text-ink-600 dark:text-gray-300 text-sm leading-relaxed line-clamp-3 mb-4">
              {c.data.description}
            </p>

            {c.data.tools && c.data.tools.length > 0 && (
              <div class="flex flex-wrap gap-1.5 pt-2">
                {c.data.tools.slice(0, 4).map((tool) => (
                  <span class="px-2 py-0.5 text-xs rounded bg-surface-alt dark:bg-navy-800 text-ink-600 dark:text-gray-300 font-mono">
                    {tool}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>

        <div class="p-6 pt-0 border-t border-transparent">
          <a
            href={caseUrl}
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#1a6ca8] hover:text-blue-700 dark:text-blue-400 group-hover:translate-x-1 transition-transform"
            aria-label={`${t(lang, 'cta.more')} - ${c.data.title}`}
          >
            <span>{t(lang, 'cta.more')}</span>
            <svg
              class="w-4 h-4"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
        </div>
      </article>
    );
  })}
</div>
