---
import type { Locale } from '../../i18n/routes';
import { path } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { site } from '../../../site.config';
import Button from '../ui/Button.astro';

export interface Props {
  lang: Locale;
  title?: string;
  text?: string;
  class?: string;
}

const { lang, title, text, class: className = '' } = Astro.props;

const defaultTitle =
  lang === 'pt'
    ? 'Pronto para planejar sua pesquisa com método e evidências?'
    : 'Ready to structure your research with rigorous methods?';

const defaultText =
  lang === 'pt'
    ? 'Fale com nossa equipe técnica para desenhar a abordagem ideal para o seu projeto.'
    : 'Talk to our team to plan the methodology for your project.';

const whatsappUrl = `https://wa.me/${site.contact.whatsapp}`;
---

<aside
  class={`relative overflow-hidden rounded-2xl bg-gradient-to-br from-navy-900 via-navy-700 to-[#16426d] text-white p-8 sm:p-12 shadow-xl ${className}`}
  aria-label="Chamada para proposta"
>
  <div class="relative z-10 max-w-3xl space-y-4">
    <h2 class="text-2xl sm:text-3xl font-extrabold font-display tracking-tight text-white">
      {title || defaultTitle}
    </h2>
    <p class="text-base sm:text-lg text-blue-100 max-w-2xl leading-relaxed">
      {text || defaultText}
    </p>
    <div class="flex flex-wrap items-center gap-4 pt-4">
      <Button
        href={path(lang, 'contact')}
        variant="primary"
        size="lg"
        class="font-semibold"
      >
        {t(lang, 'cta.proposal')}
      </Button>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-white/20 hover:bg-white/10 text-white font-medium text-base transition-colors focus:outline-none focus:ring-2 focus:ring-white"
      >
        <span>{t(lang, 'cta.whatsapp')}</span>
      </a>
    </div>
  </div>
</aside>
