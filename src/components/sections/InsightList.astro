---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import type { Locale } from '../../i18n/routes';
import { path } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { entrySlug } from '../../lib/content';
import { readingTime } from '../../lib/reading-time';
import DraftBadge from '../ui/DraftBadge.astro';

export interface Props {
  posts: CollectionEntry<'insights'>[];
  lang: Locale;
  limit?: number;
}

const { posts, lang, limit } = Astro.props;

const displayed = typeof limit === 'number' ? posts.slice(0, limit) : posts;

const postsWithAuthors = await Promise.all(
  displayed.map(async (post) => {
    const authorEntry = await getEntry(post.data.author);
    const estTime = readingTime(post.body || '');
    return {
      post,
      author: authorEntry,
      authorSlug: post.data.author.id,
      readingMinutes: estTime
    };
  })
);
---

<div class="space-y-6">
  {postsWithAuthors.map(({ post, author, authorSlug, readingMinutes }) => {
    const slug = entrySlug(post.id);
    const postUrl = `${path(lang, 'insights')}${slug}/`;
    const authorUrl = `${path(lang, 'about')}${authorSlug}/`;
    const formattedDate = new Intl.DateTimeFormat(
      lang === 'pt' ? 'pt-BR' : 'en-US',
      { day: 'numeric', month: 'long', year: 'numeric' }
    ).format(post.data.pubDate);

    return (
      <article class="bg-white dark:bg-[#112239] rounded-2xl border border-gray-200 dark:border-navy-700/60 p-6 sm:p-8 flex flex-col justify-between hover:shadow-lg transition-shadow">
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-600 dark:text-gray-400">
            <time datetime={post.data.pubDate.toISOString()}>
              {formattedDate}
            </time>
            <span>•</span>
            <span>
              {readingMinutes} {lang === 'pt' ? 'min de leitura' : 'min read'}
            </span>
            {author && (
              <>
                <span>•</span>
                <a
                  href={authorUrl}
                  class="hover:text-blue-500 underline font-medium"
                >
                  {author.data.name}
                </a>
              </>
            )}
            {post.data.draft && <DraftBadge />}
          </div>

          <h3 class="text-xl sm:text-2xl font-bold font-display text-navy-900 dark:text-white hover:text-blue-500 transition-colors">
            <a href={postUrl} class="focus:outline-none focus:underline">
              {post.data.title}
            </a>
          </h3>

          <p class="text-ink-600 dark:text-gray-300 text-sm sm:text-base leading-relaxed line-clamp-3">
            {post.data.description}
          </p>
        </div>

        <div class="pt-6 mt-4 border-t border-gray-100 dark:border-navy-700/40">
          <a
            href={postUrl}
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#1a6ca8] hover:text-blue-700 dark:text-blue-400 group-hover:translate-x-1 transition-transform"
          >
            <span>{t(lang, 'cta.more')}</span>
            <svg
              class="w-4 h-4"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
        </div>
      </article>
    );
  })}
</div>
