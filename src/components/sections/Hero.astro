---
import type { Locale } from '../../i18n/routes';
import { path } from '../../i18n/routes';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import NetworkPattern from '../ui/NetworkPattern.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../../site.config';

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const content = {
  pt: {
    eyebrow: 'Consultoria em pesquisa',
    h1: 'Evidências rigorosas para decisões e descobertas.',
    lead: 'Pesquisa quantitativa e qualitativa com método, ética e transparência.',
    primaryCta: 'Solicitar proposta',
    secondaryCta: 'Ver serviços'
  },
  en: {
    eyebrow: 'Research consultancy',
    h1: 'Rigorous evidence for decisions and discoveries.',
    lead: 'Quantitative and qualitative research with method, ethics, and transparency.',
    primaryCta: 'Request a proposal',
    secondaryCta: 'View services'
  }
}[lang];

const contactUrl = path(lang, 'contact');
const servicesUrl = path(lang, 'services');
---

<section
  data-section="hero"
  class="relative overflow-hidden pt-12 pb-20 sm:pt-20 sm:pb-28 lg:pt-24 lg:pb-36 bg-gradient-to-b from-surface-alt/70 via-white to-white dark:from-[#0B1626] dark:via-[#0F2340] dark:to-[#0B1626]"
>
  <div class="absolute inset-0 pointer-events-none opacity-80 dark:opacity-65 motion-safe:transition-opacity">
    <NetworkPattern class="w-full h-full text-[#1e78a6]/60 dark:text-blue-300/55" />
  </div>

  <Container class="relative z-10">
    <div class="max-w-3xl space-y-8">
      <div class="space-y-4">
        <span class="inline-block text-xs sm:text-sm font-bold uppercase tracking-wider text-[#1a6ca8] dark:text-blue-400 bg-blue-50/80 dark:bg-navy-900/60 px-3 py-1 rounded-full border border-blue-200/50 dark:border-blue-500/20">
          {content.eyebrow}
        </span>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold font-display text-navy-900 dark:text-white tracking-tight leading-[1.12]">
          {content.h1}
        </h1>
        <p class="text-lg sm:text-xl text-ink-600 dark:text-gray-300 leading-relaxed font-normal pt-2">
          {content.lead}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <Button href={contactUrl} variant="primary" size="lg">
          {content.primaryCta}
        </Button>
        <Button href={servicesUrl} variant="outline" size="lg">
          {content.secondaryCta}
        </Button>
        {(site.social.linkedin || site.social.instagram) && (
          <div
            class="flex items-center gap-2.5 sm:pl-2"
            aria-label={lang === 'pt' ? 'Redes sociais' : 'Social media'}
          >
            {site.social.linkedin && (
              <a
                href={site.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                class="w-12 h-12 rounded-lg flex items-center justify-center text-navy-900 dark:text-white hover:text-[#1a6ca8] dark:hover:text-blue-400 bg-white/80 dark:bg-transparent hover:bg-navy-700/5 dark:hover:bg-white/10 transition-colors border border-navy-700/20 dark:border-white/20 shadow-xs focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                <Icon
                  name="simple-icons:linkedin"
                  size={20}
                  class="w-5 h-5"
                  aria-hidden="true"
                />
              </a>
            )}
            {site.social.instagram && (
              <a
                href={site.social.instagram}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
                class="w-12 h-12 rounded-lg flex items-center justify-center text-navy-900 dark:text-white hover:text-[#1a6ca8] dark:hover:text-blue-400 bg-white/80 dark:bg-transparent hover:bg-navy-700/5 dark:hover:bg-white/10 transition-colors border border-navy-700/20 dark:border-white/20 shadow-xs focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                <Icon
                  name="simple-icons:instagram"
                  size={20}
                  class="w-5 h-5"
                  aria-hidden="true"
                />
              </a>
            )}
          </div>
        )}
      </div>
    </div>
  </Container>
</section>
