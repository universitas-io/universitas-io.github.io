---
import type { HTMLTag } from 'astro/types';

export interface Props {
  as?: HTMLTag;
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
}

const { as: Tag = 'div', class: className = '', size = 'xl' } = Astro.props;

const sizeClasses = {
  sm: 'max-w-3xl',
  md: 'max-w-5xl',
  lg: 'max-w-6xl',
  xl: 'max-w-7xl',
  full: 'max-w-full'
};
---

<Tag
  class={`w-full mx-auto px-4 sm:px-6 lg:px-8 ${sizeClasses[size]} ${className}`}
>
  <slot />
</Tag>
