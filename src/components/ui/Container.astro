---
import type { HTMLTag, Polymorphic } from 'astro/types';

export type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{
  as?: Tag;
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
}>;

const {
  as: Component = 'div',
  class: className = '',
  size = 'xl'
} = Astro.props;

const sizeClasses = {
  sm: 'max-w-3xl',
  md: 'max-w-5xl',
  lg: 'max-w-6xl',
  xl: 'max-w-7xl',
  full: 'max-w-full'
};
---

<Component
  class={`w-full mx-auto px-4 sm:px-6 lg:px-8 ${sizeClasses[size]} ${className}`}
>
  <slot />
</Component>
