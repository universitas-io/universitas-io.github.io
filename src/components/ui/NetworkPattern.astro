---

<svg
  class={`pointer-events-none select-none ${className}`}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 820 600"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <filter id="node-glow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2.5" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <!-- Network Connection Lines (Stronger stroke and distinct opacity) -->
  <g stroke="currentColor" stroke-opacity="0.38" stroke-width="1.5">
    {connections.map(([from, to]) => {
      const n1 = nodes[from];
      const n2 = nodes[to];
      return <line x1={n1.cx} y1={n1.cy} x2={n2.cx} y2={n2.cy} />;
    })}
  </g>

  <!-- Accent Highlighted Lines -->
  <g stroke="#2A8FC7" stroke-opacity="0.5" stroke-width="2">
    <line
      x1={nodes[9].cx}
      y1={nodes[9].cy}
      x2={nodes[18].cx}
      y2={nodes[18].cy}
    />
    <line
      x1={nodes[18].cx}
      y1={nodes[18].cy}
      x2={nodes[12].cx}
      y2={nodes[12].cy}
    />
    <line
      x1={nodes[12].cx}
      y1={nodes[12].cy}
      x2={nodes[26].cx}
      y2={nodes[26].cy}
    />
    <line
      x1={nodes[18].cx}
      y1={nodes[18].cy}
      x2={nodes[25].cx}
      y2={nodes[25].cy}
    />
    <line
      x1={nodes[4].cx}
      y1={nodes[4].cy}
      x2={nodes[12].cx}
      y2={nodes[12].cy}
    />
  </g>

  <!-- Constellation Nodes (Bolinhas) -->
  <g>
    {nodes.map((node) => (
      <circle
        cx={node.cx}
        cy={node.cy}
        r={node.r}
        fill={node.fill}
        opacity={node.opacity}
        filter={node.r >= 6 ? 'url(#node-glow)' : undefined}
      />
    ))}
  </g>
</svg>
