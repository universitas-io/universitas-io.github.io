---

<svg
  id="hero-constellation-svg"
  class={`select-none ${className}`}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 900 600"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <!-- Radiant node glow filter -->
    <filter id="hero-node-glow" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="3.5" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <!-- Base Network Connection Lines (Strong, visible stroke) -->
  <g
    stroke="currentColor"
    stroke-opacity="0.55"
    stroke-width="1.6"
    stroke-linecap="round"
  >
    {connections.map(([from, to]) => {
      const n1 = nodes[from];
      const n2 = nodes[to];
      return <line x1={n1.cx} y1={n1.cy} x2={n2.cx} y2={n2.cy} />;
    })}
  </g>

  <!-- Accent Analytical Backbone Lines (High contrast, luminous) -->
  <g
    stroke="#2A8FC7"
    stroke-opacity="0.8"
    stroke-width="2.4"
    stroke-linecap="round"
  >
    {backbonePairs.map(([from, to]) => {
      const n1 = nodes[from];
      const n2 = nodes[to];
      return <line x1={n1.cx} y1={n1.cy} x2={n2.cx} y2={n2.cy} />;
    })}
  </g>

  <!-- Constellation Nodes (Interactive bolinhas) -->
  <g id="hero-nodes-group">
    {nodes.map((node) => (
      <circle
        class="hero-node"
        cx={node.cx}
        cy={node.cy}
        r={node.r}
        fill={node.fill}
        opacity={node.opacity}
        data-cx={node.cx}
        data-cy={node.cy}
        data-r={node.r}
        data-fill={node.fill}
        data-opacity={node.opacity}
        filter={node.r >= 7 ? 'url(#hero-node-glow)' : undefined}
      />
    ))}
  </g>
</svg>

<style>
  .hero-node {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.25s ease,
      filter 0.25s ease;
    will-change: transform, filter, opacity;
  }
</style>

<script>
  function initHeroConstellation() {
    const heroSection = document.querySelector<HTMLElement>(
      '[data-section="hero"]'
    );
    const svg = document.getElementById(
      'hero-constellation-svg'
    ) as SVGSVGElement | null;
    if (!heroSection || !svg) return;

    const nodes = svg.querySelectorAll<SVGCircleElement>('.hero-node');
    if (!nodes.length) return;

    // Cache initial data
    const nodeData = Array.from(nodes).map((node) => {
      const cx = parseFloat(node.getAttribute('data-cx') || '0');
      const cy = parseFloat(node.getAttribute('data-cy') || '0');
      const r = parseFloat(node.getAttribute('data-r') || '4');
      const opacity = parseFloat(node.getAttribute('data-opacity') || '0.8');
      const fill = node.getAttribute('data-fill') || '#2A8FC7';
      return { el: node, cx, cy, r, opacity, fill };
    });

    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    let rafId: number | null = null;
    let activePointer = false;
    let mouseSvgX = -1000;
    let mouseSvgY = -1000;

    const INFLUENCE_RADIUS = 160;

    function updateNodes() {
      rafId = null;

      for (let i = 0; i < nodeData.length; i++) {
        const item = nodeData[i];
        if (!activePointer) {
          item.el.style.transform = '';
          item.el.style.filter = '';
          item.el.style.opacity = String(item.opacity);
          continue;
        }

        const dx = item.cx - mouseSvgX;
        const dy = item.cy - mouseSvgY;
        const dist = Math.hypot(dx, dy);

        if (dist < INFLUENCE_RADIUS) {
          const ratio = 1 - dist / INFLUENCE_RADIUS; // 0 to 1

          // 1. Move: repel smoothly away from mouse cursor
          let tx = 0;
          let ty = 0;
          if (!prefersReducedMotion) {
            const angle = Math.atan2(dy, dx);
            const pushDist = ratio * 28; // Up to 28px displacement in SVG units
            tx = Math.cos(angle) * pushDist;
            ty = Math.sin(angle) * pushDist;
          }

          // 2. Enlarge: expand scale up to 2.2x
          const scale = 1 + ratio * 1.25;

          // 3. Glow / Brighten: luminous drop shadow + 100% opacity
          const glowBlur = (4 + ratio * 10).toFixed(1);
          item.el.style.transform = `translate(${tx.toFixed(1)}px, ${ty.toFixed(1)}px) scale(${scale.toFixed(2)})`;
          item.el.style.filter = `drop-shadow(0 0 ${glowBlur}px #38BDF8)`;
          item.el.style.opacity = '1';
        } else {
          item.el.style.transform = '';
          item.el.style.filter = '';
          item.el.style.opacity = String(item.opacity);
        }
      }
    }

    const svgEl = svg;

    function onPointerMove(e: PointerEvent) {
      activePointer = true;
      const rect = svgEl.getBoundingClientRect();
      if (!rect.width || !rect.height) return;

      mouseSvgX = ((e.clientX - rect.left) / rect.width) * 900;
      mouseSvgY = ((e.clientY - rect.top) / rect.height) * 600;

      if (!rafId) {
        rafId = requestAnimationFrame(updateNodes);
      }
    }

    function onPointerLeave() {
      activePointer = false;
      mouseSvgX = -1000;
      mouseSvgY = -1000;
      if (!rafId) {
        rafId = requestAnimationFrame(updateNodes);
      }
    }

    heroSection.addEventListener('pointermove', onPointerMove, {
      passive: true
    });
    heroSection.addEventListener('pointerleave', onPointerLeave, {
      passive: true
    });
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroConstellation);
    } else {
      initHeroConstellation();
    }
  }
</script>
