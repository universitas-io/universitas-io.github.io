---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class={`pointer-events-none select-none ${className}`}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 800 600"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="network-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2A8FC7" stop-opacity="0.3"></stop>
      <stop offset="100%" stop-color="#1F3A5F" stop-opacity="0.05"></stop>
    </linearGradient>
    <radialGradient id="node-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#2A8FC7" stop-opacity="0.8"></stop>
      <stop offset="100%" stop-color="#2A8FC7" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <!-- Connection Lines -->
  <g stroke="currentColor" stroke-opacity="0.15" stroke-width="1">
    <line x1="120" y1="100" x2="280" y2="180"></line>
    <line x1="280" y1="180" x2="450" y2="120"></line>
    <line x1="450" y1="120" x2="620" y2="200"></line>
    <line x1="280" y1="180" x2="240" y2="340"></line>
    <line x1="450" y1="120" x2="420" y2="300"></line>
    <line x1="240" y1="340" x2="420" y2="300"></line>
    <line x1="420" y1="300" x2="580" y2="380"></line>
    <line x1="620" y1="200" x2="580" y2="380"></line>
    <line x1="240" y1="340" x2="380" y2="480"></line>
    <line x1="420" y1="300" x2="380" y2="480"></line>
    <line x1="580" y1="380" x2="700" y2="460"></line>
    <line x1="120" y1="100" x2="80" y2="260"></line>
    <line x1="80" y1="260" x2="240" y2="340"></line>
  </g>

  <!-- Network Nodes -->
  <g fill="currentColor">
    <circle cx="120" cy="100" r="3" opacity="0.3"></circle>
    <circle cx="280" cy="180" r="4.5" opacity="0.5" fill="#2A8FC7"></circle>
    <circle cx="450" cy="120" r="3.5" opacity="0.4"></circle>
    <circle cx="620" cy="200" r="4" opacity="0.45" fill="#2E9E6B"></circle>
    <circle cx="80" cy="260" r="3" opacity="0.25"></circle>
    <circle cx="240" cy="340" r="5" opacity="0.6" fill="#2A8FC7"></circle>
    <circle cx="420" cy="300" r="6" opacity="0.7" fill="#1F3A5F"></circle>
    <circle cx="580" cy="380" r="4.5" opacity="0.5" fill="#2A8FC7"></circle>
    <circle cx="380" cy="480" r="3.5" opacity="0.4"></circle>
    <circle cx="700" cy="460" r="3" opacity="0.3"></circle>
  </g>
</svg>
