---

<svg
  id="hero-constellation-svg"
  class={`select-none ${className}`}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 900 600"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <!-- Radiant node glow filter -->
    <filter id="hero-node-glow" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <!-- Base Network Connection Lines (Clean, balanced presence) -->
  <g stroke="currentColor" stroke-opacity="0.42" stroke-width="1.25" stroke-linecap="round">
    {connections.map(([from, to]) => {
      const n1 = nodes[from];
      const n2 = nodes[to];
      return (
        <line
          class="hero-line"
          data-from={from}
          data-to={to}
          x1={n1.cx}
          y1={n1.cy}
          x2={n2.cx}
          y2={n2.cy}
        />
      );
    })}
  </g>

  <!-- Accent Backbone Lines -->
  <g stroke="#2A8FC7" stroke-opacity="0.55" stroke-width="1.6" stroke-linecap="round">
    {backbonePairs.map(([from, to]) => {
      const n1 = nodes[from];
      const n2 = nodes[to];
      return (
        <line
          class="hero-line"
          data-from={from}
          data-to={to}
          x1={n1.cx}
          y1={n1.cy}
          x2={n2.cx}
          y2={n2.cy}
        />
      );
    })}
  </g>

  <!-- Constellation Nodes (Interactive bolinhas) -->
  <g id="hero-nodes-group">
    {nodes.map((node) => (
      <circle
        class="hero-node"
        data-id={node.id}
        cx={node.cx}
        cy={node.cy}
        r={node.r}
        fill={node.fill}
        opacity={node.opacity}
        data-cx={node.cx}
        data-cy={node.cy}
        data-r={node.r}
        data-opacity={node.opacity}
      />
    ))}
  </g>
</svg>

<script>
  function initHeroConstellation() {
    const heroSection = document.querySelector<HTMLElement>('[data-section="hero"]');
    const svg = document.getElementById('hero-constellation-svg') as SVGSVGElement | null;
    if (!heroSection || !svg) return;

    const circleEls = svg.querySelectorAll<SVGCircleElement>('.hero-node');
    const lineEls = svg.querySelectorAll<SVGLineElement>('.hero-line');
    if (!circleEls.length) return;

    // Node state collection
    const nodeStates = Array.from(circleEls).map((el) => {
      const id = parseInt(el.getAttribute('data-id') || '0', 10);
      const baseX = parseFloat(el.getAttribute('data-cx') || '0');
      const baseY = parseFloat(el.getAttribute('data-cy') || '0');
      const baseR = parseFloat(el.getAttribute('data-r') || '4');
      const baseOpacity = parseFloat(el.getAttribute('data-opacity') || '0.8');

      return {
        id,
        el,
        baseX,
        baseY,
        currX: baseX,
        currY: baseY,
        targetX: baseX,
        targetY: baseY,
        baseR,
        currR: baseR,
        targetR: baseR,
        baseOpacity,
        currOpacity: baseOpacity,
        targetOpacity: baseOpacity,
        isGlow: false
      };
    });

    // Line state collection
    const lineStates = Array.from(lineEls).map((el) => {
      const from = parseInt(el.getAttribute('data-from') || '0', 10);
      const to = parseInt(el.getAttribute('data-to') || '0', 10);
      return { el, from, to };
    });

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let rafId: number | null = null;
    let activePointer = false;
    let mouseSvgX = -2000;
    let mouseSvgY = -2000;

    const INFLUENCE_RADIUS = 150;
    const LERP_FACTOR = 0.16;

    function renderLoop() {
      rafId = null;
      let hasSignificantMovement = false;

      // 1. Calculate targets based on pointer position
      for (let i = 0; i < nodeStates.length; i++) {
        const item = nodeStates[i];

        if (activePointer) {
          const dx = item.baseX - mouseSvgX;
          const dy = item.baseY - mouseSvgY;
          const dist = Math.hypot(dx, dy);

          if (dist < INFLUENCE_RADIUS) {
            const ratio = 1 - dist / INFLUENCE_RADIUS; // 0 to 1

            if (!prefersReducedMotion) {
              const angle = Math.atan2(dy, dx);
              const pushDist = ratio * 24; // Smooth 24px organic displacement
              item.targetX = item.baseX + Math.cos(angle) * pushDist;
              item.targetY = item.baseY + Math.sin(angle) * pushDist;
            } else {
              item.targetX = item.baseX;
              item.targetY = item.baseY;
            }

            // Enlarge up to 1.6x and glow
            item.targetR = item.baseR * (1 + ratio * 0.6);
            item.targetOpacity = 1.0;
            item.isGlow = true;
          } else {
            item.targetX = item.baseX;
            item.targetY = item.baseY;
            item.targetR = item.baseR;
            item.targetOpacity = item.baseOpacity;
            item.isGlow = false;
          }
        } else {
          item.targetX = item.baseX;
          item.targetY = item.baseY;
          item.targetR = item.baseR;
          item.targetOpacity = item.baseOpacity;
          item.isGlow = false;
        }

        // 2. Smooth lerp position, radius and opacity
        const diffX = item.targetX - item.currX;
        const diffY = item.targetY - item.currY;
        const diffR = item.targetR - item.currR;
        const diffO = item.targetOpacity - item.currOpacity;

        if (
          Math.abs(diffX) > 0.05 ||
          Math.abs(diffY) > 0.05 ||
          Math.abs(diffR) > 0.05 ||
          Math.abs(diffO) > 0.01
        ) {
          hasSignificantMovement = true;
          item.currX += diffX * LERP_FACTOR;
          item.currY += diffY * LERP_FACTOR;
          item.currR += diffR * LERP_FACTOR;
          item.currOpacity += diffO * LERP_FACTOR;
        } else {
          item.currX = item.targetX;
          item.currY = item.targetY;
          item.currR = item.targetR;
          item.currOpacity = item.targetOpacity;
        }

        // Apply circle attributes
        item.el.setAttribute('cx', item.currX.toFixed(2));
        item.el.setAttribute('cy', item.currY.toFixed(2));
        item.el.setAttribute('r', item.currR.toFixed(2));
        item.el.setAttribute('opacity', item.currOpacity.toFixed(2));

        if (item.isGlow) {
          item.el.style.filter = 'drop-shadow(0 0 7px #38BDF8)';
        } else {
          item.el.style.filter = '';
        }
      }

      // 3. Update all attached lines so they stay 100% attached to the moving nodes
      for (let j = 0; j < lineStates.length; j++) {
        const line = lineStates[j];
        const n1 = nodeStates[line.from];
        const n2 = nodeStates[line.to];

        line.el.setAttribute('x1', n1.currX.toFixed(2));
        line.el.setAttribute('y1', n1.currY.toFixed(2));
        line.el.setAttribute('x2', n2.currX.toFixed(2));
        line.el.setAttribute('y2', n2.currY.toFixed(2));
      }

      // Keep animation running while active or settling back
      if (activePointer || hasSignificantMovement) {
        rafId = requestAnimationFrame(renderLoop);
      }
    }

    const svgEl = svg;

    function onPointerMove(e: PointerEvent) {
      activePointer = true;
      const rect = svgEl.getBoundingClientRect();
      if (!rect.width || !rect.height) return;

      mouseSvgX = ((e.clientX - rect.left) / rect.width) * 900;
      mouseSvgY = ((e.clientY - rect.top) / rect.height) * 600;

      if (!rafId) {
        rafId = requestAnimationFrame(renderLoop);
      }
    }

    function onPointerLeave() {
      activePointer = false;
      mouseSvgX = -2000;
      mouseSvgY = -2000;

      if (!rafId) {
        rafId = requestAnimationFrame(renderLoop);
      }
    }

    heroSection.addEventListener('pointermove', onPointerMove, { passive: true });
    heroSection.addEventListener('pointerleave', onPointerLeave, { passive: true });
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroConstellation);
    } else {
      initHeroConstellation();
    }
  }
</script>
