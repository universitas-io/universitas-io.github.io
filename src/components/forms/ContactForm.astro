---
import type { Locale } from '../../i18n/routes';
import { path } from '../../i18n/routes';
import { getLocalized } from '../../lib/content';
import { site } from '../../../site.config';
import Button from '../ui/Button.astro';

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const web3formsKey = site.integrations.web3formsKey;
const services = await getLocalized('services', lang);

const thanksUrl = `${site.url}${path(lang, 'thanks')}`;
const privacyUrl = path(lang, 'privacy');
const waUrl = `https://wa.me/${site.contact.whatsapp}`;
const mailUrl = `mailto:${site.contact.email}`;

const orgTypeOptions = {
  pt: [
    { value: '', label: 'Selecione o setor da sua instituição *' },
    { value: 'academia', label: 'Academia / Universidade / Pós-Graduação' },
    { value: 'business', label: 'Empresa / Setor Privado' },
    { value: 'public', label: 'Setor Público / Governo / Autarquia' },
    { value: 'ngo', label: 'Terceiro Setor / Fundação / ONG' },
    { value: 'other', label: 'Outro' }
  ],
  en: [
    { value: '', label: 'Select your organization sector *' },
    { value: 'academia', label: 'Academia / University / Graduate Program' },
    { value: 'business', label: 'Business / Corporate / Private Sector' },
    { value: 'public', label: 'Public Sector / Government Agency' },
    { value: 'ngo', label: 'Non-Profit / NGO / Foundation' },
    { value: 'other', label: 'Other' }
  ]
}[lang];
---

{!web3formsKey ? (
  <div class="p-8 rounded-2xl bg-surface-alt dark:bg-navy-900 border border-gray-200 dark:border-navy-700/60 space-y-4 text-center max-w-xl mx-auto">
    <div class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-navy-800 text-[#1a6ca8] dark:text-blue-400 flex items-center justify-center mx-auto">
      <svg
        class="w-6 h-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
        />
      </svg>
    </div>
    <h3 class="text-xl font-bold font-display text-navy-900 dark:text-white">
      {lang === 'pt' ? 'Fale conosco diretamente' : 'Contact us directly'}
    </h3>
    <p class="text-sm text-ink-600 dark:text-gray-300 leading-relaxed">
      {lang === 'pt'
        ? 'Para solicitar uma proposta metodológica ou tirar dúvidas sobre nossos serviços de pesquisa, envie uma mensagem pelos nossos canais diretos:'
        : 'To request a research proposal or discuss project requirements, please contact our team directly:'}
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <Button href={waUrl} variant="primary" size="md">
        WhatsApp
      </Button>
      <Button href={mailUrl} variant="outline" size="md">
        {lang === 'pt' ? 'E-mail' : 'Email'}
      </Button>
    </div>
  </div>
) : (
  <form
    method="POST"
    action="https://api.web3forms.com/submit"
    data-contact-form
    data-lang={lang}
    data-whatsapp={site.contact.whatsapp}
    data-email={site.contact.email}
    class="space-y-6 bg-white dark:bg-[#112239] p-6 sm:p-10 rounded-3xl border border-gray-200 dark:border-navy-700/60 shadow-sm"
  >
    <!-- Hidden web3forms fields -->
    <input type="hidden" name="access_key" value={web3formsKey} />
    <input
      type="hidden"
      name="subject"
      value={
        lang === 'pt'
          ? 'Nova solicitação de proposta: site Universitas'
          : 'New proposal inquiry: Universitas website'
      }
    />
    <input type="hidden" name="from_name" value="Site Universitas" />
    <input type="hidden" name="redirect" value={thanksUrl} />
    <input
      type="checkbox"
      name="botcheck"
      class="hidden"
      tabindex="-1"
      autocomplete="off"
      style="display:none"
    />

    <!-- Status feedback region -->
    <div data-form-status aria-live="polite" class="hidden"></div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <!-- Name -->
      <div class="space-y-2">
        <label
          for="contact-name"
          class="block text-xs font-bold uppercase tracking-wider text-navy-900 dark:text-gray-200"
        >
          {lang === 'pt' ? 'Nome completo *' : 'Full name *'}
        </label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          placeholder={lang === 'pt' ? 'Seu nome' : 'Your name'}
          class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-navy-700 bg-surface-alt/50 dark:bg-navy-900/80 text-navy-900 dark:text-white placeholder-ink-600/50 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#1a6ca8] dark:focus:ring-blue-400 text-sm transition-all"
        />
      </div>

      <!-- Email -->
      <div class="space-y-2">
        <label
          for="contact-email"
          class="block text-xs font-bold uppercase tracking-wider text-navy-900 dark:text-gray-200"
        >
          {lang === 'pt' ? 'E-mail profissional *' : 'Work email *'}
        </label>
        <input
          type="email"
          id="contact-email"
          name="email"
          required
          autocomplete="email"
          placeholder={
            lang === 'pt' ? 'exemplo@instituicao.br' : 'example@institution.edu'
          }
          class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-navy-700 bg-surface-alt/50 dark:bg-navy-900/80 text-navy-900 dark:text-white placeholder-ink-600/50 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#1a6ca8] dark:focus:ring-blue-400 text-sm transition-all"
        />
        <p
          id="contact-email-error"
          class="hidden text-xs text-red-600 dark:text-red-400 font-medium"
        ></p>
      </div>

      <!-- Organization -->
      <div class="space-y-2">
        <label
          for="contact-organization"
          class="block text-xs font-bold uppercase tracking-wider text-navy-900 dark:text-gray-200"
        >
          {lang === 'pt'
            ? 'Instituição ou empresa'
            : 'Organization or institution'}
        </label>
        <input
          type="text"
          id="contact-organization"
          name="organization"
          placeholder={
            lang === 'pt'
              ? 'Nome da universidade, empresa ou órgão'
              : 'University, company or agency name'
          }
          class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-navy-700 bg-surface-alt/50 dark:bg-navy-900/80 text-navy-900 dark:text-white placeholder-ink-600/50 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#1a6ca8] dark:focus:ring-blue-400 text-sm transition-all"
        />
      </div>

      <!-- Phone / WhatsApp -->
      <div class="space-y-2">
        <label
          for="contact-phone"
          class="block text-xs font-bold uppercase tracking-wider text-navy-900 dark:text-gray-200"
        >
          {lang === 'pt' ? 'Telefone / WhatsApp' : 'Phone / WhatsApp'}
        </label>
        <input
          type="tel"
          id="contact-phone"
          name="phone"
          autocomplete="tel"
          inputmode="tel"
          placeholder="+55 (11) 99999-9999"
          class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-navy-700 bg-surface-alt/50 dark:bg-navy-900/80 text-navy-900 dark:text-white placeholder-ink-600/50 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#1a6ca8] dark:focus:ring-blue-400 text-sm transition-all"
        />
        <p
          id="contact-phone-error"
          class="hidden text-xs text-red-600 dark:text-red-400 font-medium"
        ></p>
      </div>

      <!-- Organization Sector -->
      <div class="space-y-2">
        <label
          for="contact-org-type"
          class="block text-xs font-bold uppercase tracking-wider text-navy-900 dark:text-gray-200"
        >
          {lang === 'pt' ? 'Setor da organização *' : 'Organization sector *'}
        </label>
        <select
          id="contact-org-type"
          name="org_type"
          required
          class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-navy-700 bg-surface-alt/50 dark:bg-navy-900/80 text-navy-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#1a6ca8] dark:focus:ring-blue-400 text-sm transition-all"
        >
          {orgTypeOptions.map((opt, i) => (
            <option value={opt.value} disabled={i === 0} selected={i === 0}>
              {opt.label}
            </option>
          ))}
        </select>
      </div>

      <!-- Service of Interest -->
      <div class="space-y-2">
        <label
          for="contact-service"
          class="block text-xs font-bold uppercase tracking-wider text-navy-900 dark:text-gray-200"
        >
          {lang === 'pt' ? 'Serviço de interesse *' : 'Service of interest *'}
        </label>
        <select
          id="contact-service"
          name="service"
          required
          class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-navy-700 bg-surface-alt/50 dark:bg-navy-900/80 text-navy-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#1a6ca8] dark:focus:ring-blue-400 text-sm transition-all"
        >
          <option value="" disabled selected>
            {lang === 'pt'
              ? 'Selecione o serviço principal *'
              : 'Select primary service *'}
          </option>
          {services.map((srv) => (
            <option value={srv.data.translationKey}>{srv.data.title}</option>
          ))}
          <option value="not-sure">
            {lang === 'pt'
              ? 'Não sei ainda / A definir em conversa'
              : 'Not sure yet / Needs discussion'}
          </option>
        </select>
      </div>
    </div>

    <!-- Estimated Timeline -->
    <div class="space-y-2">
      <label
        for="contact-deadline"
        class="block text-xs font-bold uppercase tracking-wider text-navy-900 dark:text-gray-200"
      >
        {lang === 'pt'
          ? 'Prazo estimado ou data limite'
          : 'Estimated timeline or deadline'}
      </label>
      <input
        type="text"
        id="contact-deadline"
        name="deadline"
        placeholder={
          lang === 'pt'
            ? 'Ex.: 2 meses, até novembro, flexível'
            : 'e.g. 2 months, by November, flexible'
        }
        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-navy-700 bg-surface-alt/50 dark:bg-navy-900/80 text-navy-900 dark:text-white placeholder-ink-600/50 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#1a6ca8] dark:focus:ring-blue-400 text-sm transition-all"
      />
    </div>

    <!-- Message Description -->
    <div class="space-y-2">
      <label
        for="contact-message"
        class="block text-xs font-bold uppercase tracking-wider text-navy-900 dark:text-gray-200"
      >
        {lang === 'pt'
          ? 'Descrição da demanda ou pergunta de pesquisa *'
          : 'Project description or research inquiry *'}
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="5"
        required
        placeholder={
          lang === 'pt'
            ? 'Conte-nos sobre os objetivos da sua pesquisa, o público-alvo ou os dados necessários. Quanto mais detalhes, mais precisa será nossa proposta inicial.'
            : 'Describe your research goals, sample population, or data challenges. More context allows us to formulate a precise methodological memo.'
        }
        class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-navy-700 bg-surface-alt/50 dark:bg-navy-900/80 text-navy-900 dark:text-white placeholder-ink-600/50 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#1a6ca8] dark:focus:ring-blue-400 text-sm transition-all"
      ></textarea>
    </div>

    <!-- Privacy Consent Checkbox -->
    <div class="flex items-start gap-3 pt-2">
      <input
        type="checkbox"
        id="contact-consent"
        name="consent"
        required
        class="mt-1 w-4 h-4 rounded text-[#1a6ca8] focus:ring-blue-500 border-gray-300 dark:border-navy-700"
      />
      <label
        for="contact-consent"
        class="text-xs text-ink-600 dark:text-gray-300 leading-relaxed"
      >
        {lang === 'pt' ? (
          <>
            Declaro que li e concordo com a{' '}
            <a
              href={privacyUrl}
              target="_blank"
              class="font-semibold text-[#1a6ca8] dark:text-blue-400 underline hover:text-blue-700"
            >
              Política de Privacidade
            </a>{' '}
            da Universitas para tratamento dos dados informados nesta
            solicitação.
          </>
        ) : (
          <>
            I declare that I have read and agree to the{' '}
            <a
              href={privacyUrl}
              target="_blank"
              class="font-semibold text-[#1a6ca8] dark:text-blue-400 underline hover:text-blue-700"
            >
              Privacy Policy
            </a>{' '}
            of Universitas regarding the handling of information submitted in
            this form.
          </>
        )}
      </label>
    </div>

    <!-- Submit Button -->
    <div class="pt-4">
      <button
        type="submit"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-3.5 rounded-xl bg-[#1a6ca8] hover:bg-[#155a8a] text-white font-bold text-sm tracking-wide transition-all shadow-md hover:shadow-lg disabled:opacity-60 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
      >
        <span
          data-btn-spinner
          class="hidden w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"
        ></span>
        <span data-btn-text>
          {lang === 'pt'
            ? 'Enviar solicitação de proposta'
            : 'Send proposal inquiry'}
        </span>
      </button>
    </div>
  </form>
)}

<script>
  import '../../scripts/contact-form';
</script>
